# flipper.family production launch (contracts/script/mainnet.sh). Copy to contracts/.env.mainnet and fill in.
# Deploy the web (Vercel) and the API (Railway) first: the API boots "awaiting deployment" and this script configures it.

# The owner: your Ledger account. Deploys and owns every contract and every ProxyAdmin, owns the PrincipalLock.
OWNER_ADDRESS=
# Its derivation path on the Ledger, in double quotes (Ledger Live account 1 = m/44'/60'/0'/0/0, account 2 = m/44'/60'/1'/0/0)
LEDGER_PATH="m/44'/60'/0'/0/0"

# The API (Railway) and its admin key (the same ADMIN_API_KEY as on Railway). The API generates and holds the operator,
# upkeep and claim keys (the claim key is the PrincipalLock's dev claim wallet: it sweeps the team's earnings to the
# destination you set on the site, signed in with this Ledger); the script funds them and publishes the deployment.
API_URL=https://api.flipper.family
ADMIN_API_KEY=
# the site: `live` checks it serves the deployment
WEB_URL=https://flipper.family
# optional public site settings, published with the deployment (a JSON object, in single quotes)
# SITE_SETTINGS_JSON='{"browserRpcUrl":"https://rpc.mainnet.chain.robinhood.com"}'

RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Etherscan V2 key (verify step; Sourcify/Blockscout need none)
ETHERSCAN_API_KEY=

# Launch (defaults shown)
V4_START_MCAP_USD=5000
OPENING_BUY_SUPPLY_BPS=1500
# the launch refuses to spend more ETH than this on the opening buy (≈0.34 ETH at ETH $2,670)
MAX_OPENING_BUY_ETH=500000000000000000
# 1: also lock the pool position in UNCX (0.1 ETH + 1% of the position unless UNCX whitelists the keeper)
UNCX_LOCK=0

# Funding from the Ledger (top-ups to these balances, in wei)
OPERATOR_FUND_WEI=5000000000000000
UPKEEP_FUND_WEI=50000000000000000
CLAIM_FUND_WEI=10000000000000000

# GitHub token for the release and record steps' pushes (the flipperdotfamily account). Leave unset: the script reads
# it from the main repo's .env.deploy, or falls back to your own git credentials.
# GITHUB_SECRET_KEY=
