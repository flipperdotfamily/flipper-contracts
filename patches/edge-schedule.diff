+        uint256 hi = 1e30;
+        while (hi - lo > 1) {
+            uint256 mid = (lo + hi) / 2;
+            if (house.previewFlip(address(flipperToken), mid).code == 0) lo = mid;
+            else hi = mid;
+        }
+        FlipperHouseBase.Preview memory above = house.previewFlip(address(flipperToken), lo + 1);
+        assertEq(above.code, 7);
+        uint256 fee = house.randomnessFeeFor(address(flipperToken));
+        flipperToken.mint(alice, lo + 1);
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(FlipperHouseBase.FlipRejected.selector, uint8(7)));
+        house.flip{value: fee}(address(flipperToken), lo + 1, 0, block.timestamp);
+        uint256 id = _flip(alice, address(flipperToken), lo);
+        (,, uint16 w,,,,,,,,, uint16 p) = house.flips(id);
+        assertEq(w, 4625);
+        assertEq(p, 20_250);
+    }
+
+    function test_schedule_bounds() public {
+        FlipperHouseBase.EdgeSchedule memory s = _schedule(REF);
+        vm.startPrank(owner);
+        s.toBps = s.fromBps;
+        vm.expectRevert(FlipperHouseBase.InvalidParams.selector);
+        house.setEdgeSchedule(s);
+        s = _schedule(REF);
+        s.winEndBps = 3999; // under minWinChanceBps
+        vm.expectRevert(FlipperHouseBase.InvalidParams.selector);
+        house.setEdgeSchedule(s);
+        s = _schedule(REF);
+        s.payoutEndBps = 19_999; // under 2x
+        vm.expectRevert(FlipperHouseBase.InvalidParams.selector);
+        house.setEdgeSchedule(s);
+        s = _schedule(REF);
+        s.winEndBps = 4900; // 49% × 2.0 = 2% edge: ok; × 2.01 would be 1.51%
+        s.payoutEndBps = 20_100;
+        vm.expectRevert(FlipperHouseBase.InvalidParams.selector);
+        house.setEdgeSchedule(s);
+        // Params can't later break the schedule
+        FlipperHouseBase.Params memory p = house.params();
+        p.minWinChanceBps = 4501;
+        p.baseWinChanceBps = 4600;
+        vm.expectRevert(FlipperHouseBase.InvalidParams.selector);
+        house.setParams(p);
+        // off: Params' odds
+        s.refTreasury = 0;
+        house.setEdgeSchedule(s);
+        vm.stopPrank();
+        (uint256 w, uint256 pay) = _terms();
+        assertEq(w, house.params().baseWinChanceBps);
+        assertEq(pay, house.params().flipperPayoutBps);
+    }
+
+    // ── drawdown-scaled Kelly ────────────────────────────────────────────────────────────────────────────
+
+    function test_kelly_backs_off_to_quarter_at_the_breaker() public {
+        uint256[6] memory ddBps = [uint256(0), 1000, 2500, 4000, 4900, 5000];
+        uint256[6] memory k = [uint256(5000), 4500, 3750, 3000, 2550, 2500];
+        uint256 prevFrac = type(uint256).max;
+        for (uint256 i; i < 6; ++i) {
+            _setTreasury(REF * (BPS - ddBps[i]) / BPS);
+            assertEq(house.currentKellyBps(), k[i], "kelly");
+            FlipperHouseBase.Preview memory pv = house.previewFlip(address(flipperToken), 1 ether);
+            uint256 frac = pv.maxLiability * 1e18 / (house.treasury() - house.reserved());
+            assertLt(frac, prevFrac, "the cap shrinks with the drawdown");
+            prevFrac = frac;
+        }
+        house.checkDrawdown();
+        assertFalse(house.locked(), "exactly half: still open");
+    }
+
+    function test_kelly_is_max_before_the_check_is_live() public {
+        vm.prank(owner);
+        house.setLockMinTreasury(uint128(200 * M)); // the drawdown check isn't live below this
+        _setTreasury(60 * M); // a 40% drawdown, but under the dust guard
+        assertEq(house.currentKellyBps(), 5000);
+    }
+
+    function test_kelly_schedule_bounds() public {
+        vm.startPrank(owner);
+        vm.expectRevert(FlipperHouseBase.InvalidParams.selector);
+        house.setKellySchedule(5000, 0, 0, 5000); // min 0
+        vm.expectRevert(FlipperHouseBase.InvalidParams.selector);
+        house.setKellySchedule(5000, 5001, 0, 5000); // min > max
+        vm.expectRevert(FlipperHouseBase.InvalidParams.selector);
+        house.setKellySchedule(10_001, 2500, 0, 5000);
+        vm.expectRevert(FlipperHouseBase.InvalidParams.selector);
+        house.setKellySchedule(5000, 2500, 5000, 5000); // start ≥ end
+        vm.expectRevert(FlipperHouseBase.InvalidParams.selector);
+        house.setKellySchedule(5000, 2500, 0, 5001); // past the breaker
+        house.setKellySchedule(8000, 2000, 1000, 4000);
+        vm.stopPrank();
+        assertEq(house.params().kellyBps, 8000);
+        assertEq(house.kellyMinBps(), 2000);
+    }
+
+    /// @dev exact Kelly f* (WAD) of a $FLIPPER flip at win chance `w` and payout `pay`, half the edge to holders
+    function _fStar(uint256 w, uint256 pay) internal pure returns (uint256) {
+        uint256 e = BPS - Math.mulDiv(w, pay, BPS, Math.Rounding.Ceil);
+        uint256 q = BPS - w;
+        uint256 g = WAD - Math.mulDiv(WAD, e * 5000, BPS * q);
+        uint256 loss = w * Math.mulDiv((pay - BPS) * WAD / BPS, WAD, g);
+        return q * WAD > loss ? (q * WAD - loss) / BPS : 0;
+    }
+
+    /// the cap never exceeds max Kelly × f* of the unreserved bankroll, at any drawdown and any point of the schedule
+    function testFuzz_cap_never_above_max_kelly(uint256 dd, uint256 growth) public {
+        dd = bound(dd, 0, 4999);
+        growth = bound(growth, 0, 80_000); // up to 9× the reference
+        uint256 t = REF * (BPS + growth) / BPS;
+        _setTreasury(t);
+        house.checkDrawdown(); // raise the ATH to it
+        _setTreasury(t * (BPS - dd) / BPS);
+        (uint256 w, uint256 pay) = _terms();
+        FlipperHouseBase.Preview memory pv = house.previewFlip(address(flipperToken), 1 ether);
+        uint256 unres = house.treasury() - house.reserved();
+        uint256 ref = Math.mulDiv(unres, _fStar(w, pay) * 5000, WAD * BPS);
+        assertLe(pv.maxLiability, ref + ref / 1e12 + 1, "never above max Kelly x f*");
+        assertLe(house.currentKellyBps(), 5000);
+        assertGe(house.currentKellyBps(), 2500);
+    }
+
+    // ── no same-transaction gain from inflows ────────────────────────────────────────────────────────────
+
+    /// A huge vault deposit moves the schedule to its end (5% edge) and raises the cap, but every flip is still
+    /// negative for the player, and the deposit can't leave for 30 days.
+    function test_a_large_deposit_cant_be_flipped_against_profitably() public {
+        vault.crystallize();
+        flipperToken.mint(mallory, 2_000 * M);
+        vm.startPrank(mallory);
+        flipperToken.approve(address(vault), type(uint256).max);
+        uint256 shares = vault.deposit(1_000 * M, 0); // 11x the reference
+        vm.stopPrank();
+        (uint256 w, uint256 pay) = _terms();
+        assertEq(w, 4750);
+        assertEq(pay, 20_000);
+        assertLt(w * pay, BPS * BPS, "a $FLIPPER flip still loses 5% on average");
+        FlipperHouseBase.Preview memory pv = house.previewFlip(address(t0), 10_000 ether);
+        assertLe(2 * pv.winChanceBps + pv.routeCostBps + 200, BPS, "a token flip still keeps >= 2%");
+        vm.prank(mallory);
+        vm.expectRevert(abi.encodeWithSelector(TreasuryVault.Locked.selector, vault.unlockAt(mallory)));
+        vault.requestWithdraw(shares);
+        assertGe(vault.unlockAt(mallory), vm.getBlockTimestamp() + 30 days - 1);
+    }
+
+    /// A donation (unrecoverable) that moves the schedule buys less expected value than it costs.
+    function test_a_donation_costs_more_than_the_odds_it_buys() public {
+        uint256 d = 500 * M;
+        _donate(d);
+        FlipperHouseBase.Preview memory pv = house.previewFlip(address(flipperToken), 1 ether);
+        uint256 maxStake = pv.maxLiability * BPS / (house.currentFlipperPayoutBps() - BPS);
+        // the edge fell by 7.75% − 5% = 2.75% of the stake per flip: far less than the donation even at the max stake
+        assertLt(maxStake * 275 / BPS, d / 10);
+    }
+}
